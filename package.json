{
  "name": "waterchain",
  "version": "0.6.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test:engine": "python -m unittest discover -s engine -p test_*.py -v",
    "validate:holdout": "python engine/run_holdout_validation.py",
    "validate:evaluation": "python engine/evaluate.py",
    "validate:manifest": "python engine/build_reproducibility_manifest.py",
    "test:e2e": "playwright test",
    "test:dataset-adapter": "python -m unittest discover -s research/datasets -p test_*.py -v",
    "test:all-python": "python -m unittest discover -s engine -p test_*.py -v",
    "check:ts-syntax": "node scripts/check-typescript-syntax.cjs",
    "test:temporal-e2e": "playwright test tests/e2e/temporal-evidence.spec.ts",
    "test:independent-review": "node --test tests/unit/independent-review.test.cjs",
    "test:independent-review-e2e": "playwright test tests/e2e/independent-validation.spec.ts",
    "test:step19-tools": "python -m unittest discover -s validation -p 'test_*.py' -v",
    "score:independent-review": "python validation/score_independent_review.py",
    "analyze:user-evaluation": "python validation/analyze_user_evaluation.py"
  },
  "dependencies": {
    "@xyflow/react": "^12.8.5",
    "lucide-react": "^0.468.0",
    "next": "^15.2.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^15.2.4",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.2"
  }
}
